DATABASE_URL="postgresql://game:game@localhost:5432/skin_disease_game"
PORT=4000

# OAuth 2.0 client ID from Google Cloud Console credentials for this project (not secret).
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# Signs the session cookie. Generate with e.g. `openssl rand -base64 32`.
COOKIE_SECRET="replace-with-a-long-random-secret"
# Optional. Session lifetime in milliseconds. Defaults to 30 days if unset.
SESSION_TTL_MS=2592000000
