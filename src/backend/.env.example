DATABASE_URL="postgresql://game:game@localhost:5432/skin_disease_game"
PORT=4000

# OAuth 2.0 client ID from Google Cloud Console credentials for this project (not secret).
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
# Signs the session cookie. Generate with e.g. `openssl rand -base64 32`.
COOKIE_SECRET="replace-with-a-long-random-secret"
# Optional. Session lifetime in milliseconds. Defaults to 30 days if unset.
SESSION_TTL_MS=2592000000
# Origin allowed to make credentialed CORS requests (the frontend's dev/deployed URL).
FRONTEND_ORIGIN="http://localhost:4173"
# Optional. Max requests per IP per RATE_LIMIT_WINDOW_MS. Defaults to 100 if unset.
RATE_LIMIT_MAX=100
# Optional. Rate-limit window in milliseconds. Defaults to 60000 (1 minute) if unset.
RATE_LIMIT_WINDOW_MS=60000
# Google Generative Language API key for the Gemini chat model (not the OAuth client ID above).
GEMINI_API_KEY="replace-with-a-gemini-api-key"
# Optional. Defaults to "gemini-2.0-flash" if unset.
GEMINI_MODEL="gemini-2.0-flash"
# Optional. Selects which LLM backs POST /api/v1/chat: "gemini" (default) or "mock".
# "mock" is LOCAL/DEV ONLY: it returns a canned patient reply with no network call and
# no GEMINI_API_KEY needed, for when the Gemini free-tier quota returns 429. Never set
# this to "mock" in production.
CHAT_LLM_PROVIDER="gemini"
# Whisper (open-source) speech-to-text — OpenAI-compatible /audio/transcriptions endpoint.
# Point at any Whisper server you run: whisper.cpp server, faster-whisper-server, LocalAI, etc.
WHISPER_BASE_URL=http://localhost:8000/v1
WHISPER_MODEL=whisper-1
# Optional — most local servers need no key; set only if your server requires one.
WHISPER_API_KEY=
# Optional. Max accepted chat audio upload size in bytes. Defaults to 10 MiB if unset.
CHAT_AUDIO_MAX_BYTES=10485760
