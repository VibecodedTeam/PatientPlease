enum Sex {
  MALE
  FEMALE
  OTHER
}

enum CaseDifficulty {
  EASY
  MEDIUM
  HARD
}

enum BodyRegion {
  HEAD
  NECK
  CHEST
  BACK
  ABDOMEN
  LEFT_ARM
  RIGHT_ARM
  LEFT_LEG
  RIGHT_LEG
  HAND
  FOOT
  OTHER
}

/// A patient's identity/presentation, shown on the day-phase desk and 3D scene.
model Patient {
  id               String   @id @default(uuid(7)) @db.Uuid
  name             String
  age              Int
  sex              Sex
  occupation       String?
  chiefComplaint   String
  portraitImageUrl String
  bodyModelVariant String
  createdAt        DateTime @default(now())

  case Case?
}

/// The scoreable encounter for a Patient: answer key, economy, and everything documenting it.
model Case {
  id                    String         @id @default(uuid(7)) @db.Uuid
  patientId             String         @unique @db.Uuid
  patient               Patient        @relation(fields: [patientId], references: [id])
  difficulty            CaseDifficulty
  unlockDay             Int?
  correctDiagnosisId    String         @db.Uuid
  correctDiagnosis      Diagnosis      @relation(fields: [correctDiagnosisId], references: [id])
  correctTreatmentId    String?        @db.Uuid
  correctTreatment      Treatment?     @relation(fields: [correctTreatmentId], references: [id])
  moneyReward           Int
  moneyPenalty          Int
  resultExplanationText String
  isActive              Boolean        @default(true)
  createdAt             DateTime       @default(now())

  documents         CaseDocument[]
  attentionPoints   AttentionPoint[]
  hints             CaseHint[]
  diagnosisAttempts DiagnosisAttempt[]
  chatMessages      ChatMessage[]
  gameplayLogs      GameplayLog[]

  @@index([correctDiagnosisId])
  @@index([correctTreatmentId])
  @@index([isActive, unlockDay])
}

/// A clickable/zoomable hotspot on the 3D-rendered patient (lesion, mole, rash, etc.).
model AttentionPoint {
  id           String     @id @default(uuid(7)) @db.Uuid
  caseId       String     @db.Uuid
  case         Case       @relation(fields: [caseId], references: [id])
  label        String
  bodyRegion   BodyRegion
  positionX    Float
  positionY    Float
  positionZ    Float
  hitboxRadius Float
  zoomDistance Float?
  zoomYaw      Float?
  zoomPitch    Float?
  isKeyFinding Boolean
  sortOrder    Int

  documents CaseDocument[]

  @@index([caseId, sortOrder])
}
