enum CaseDocumentType {
  SKIN_IMAGE
  DISEASE_HISTORY
  UV_EXPOSURE_HISTORY
  CLINICAL_SYMPTOMS
  FAMILY_HISTORY
  WEATHER_HISTORY
  EXAMINATION_RESULTS
}

enum BodyRegion {
  HEAD
  NECK
  CHEST
  BACK
  ABDOMEN
  LEFT_ARM
  RIGHT_ARM
  LEFT_LEG
  RIGHT_LEG
  LEFT_HAND
  RIGHT_HAND
  LEFT_FOOT
  RIGHT_FOOT
  OTHER
}

/// One shared model for every kind of desk documentation the player reviews.
/// Image-specific fields are typed; everything else whose shape varies by
/// `type` lives in `content`, validated per-type at the API boundary.
model CaseDocument {
  id                   String           @id @default(uuid(7)) @db.Uuid
  caseId               String           @db.Uuid
  case                 Case             @relation(fields: [caseId], references: [id])
  attentionPointRegion BodyRegion?
  type                 CaseDocumentType
  title                String
  documentDate         DateTime?
  sortOrder            Int

  imageUrl      String?
  imageWidthPx  Int?
  imageHeightPx Int?
  imageAltText  String?

  content Json?

  @@unique([attentionPointRegion, caseId])
  @@index([caseId, sortOrder])
}
