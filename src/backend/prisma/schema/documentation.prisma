enum CaseDocumentType {
  SKIN_IMAGE
  DISEASE_HISTORY
  UV_EXPOSURE_HISTORY
  CLINICAL_SYMPTOMS
  FAMILY_HISTORY
  WEATHER_HISTORY
}

enum BodyRegion {
  HEAD
  NECK
  CHEST
  BACK
  ABDOMEN
  LEFT_ARM
  RIGHT_ARM
  LEFT_LEG
  RIGHT_LEG
  LEFT_HAND
  RIGHT_HAND
  LEFT_FOOT
  RIGHT_FOOT
  OTHER
}

/// One shared model for every kind of desk documentation the player reviews.
/// Image-specific fields are typed; everything else whose shape varies by
/// `type` lives in `content`, validated per-type at the API boundary.
model CaseDocument {
  id               String           @id @default(uuid(7)) @db.Uuid
  caseId           String           @db.Uuid
  case             Case             @relation(fields: [caseId], references: [id])
  attentionPointRegion  BodyRegion?
  type             CaseDocumentType
  title            String
  documentDate     DateTime?
  sortOrder        Int

  imageUrl      String?
  imageWidthPx  Int?
  imageHeightPx Int?
  imageAltText  String?

  content Json?

  reveals CaseDocumentReveal[]

  @@index([caseId, sortOrder])
  @@unique([attentionPointRegion, caseId])
}

/// Tracks which case documents a GameSession has unlocked via chat, so reveals dedupe across turns.
model CaseDocumentReveal {
  id             String       @id @default(uuid(7)) @db.Uuid
  gameSessionId  String       @db.Uuid
  gameSession    GameSession  @relation(fields: [gameSessionId], references: [id])
  caseId         String       @db.Uuid
  case           Case         @relation(fields: [caseId], references: [id])
  caseDocumentId String       @db.Uuid
  caseDocument   CaseDocument @relation(fields: [caseDocumentId], references: [id])
  revealedAt     DateTime     @default(now())

  @@unique([gameSessionId, caseDocumentId])
  @@index([gameSessionId, caseId])
}
