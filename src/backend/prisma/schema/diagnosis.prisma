enum DiagnosisCategory {
  BENIGN
  MALIGNANT
  INFLAMMATORY
  INFECTIOUS
  OTHER
}

enum TreatmentKind {
  TOPICAL
  ORAL_MEDICATION
  PROCEDURE
  REFERRAL
  MONITORING
  NONE
}

/// Catalog of selectable diagnoses shown in the diagnosis-selection panel.
model Diagnosis {
  id          String            @id @default(uuid(7)) @db.Uuid
  code        String            @unique
  name        String
  description String
  category    DiagnosisCategory

  correctForCases   Case[]
  diagnosisAttempts DiagnosisAttempt[]
}

/// Catalog of selectable treatments shown in the diagnosis-selection panel.
model Treatment {
  id          String        @id @default(uuid(7)) @db.Uuid
  code        String        @unique
  name        String
  description String
  kind        TreatmentKind

  correctForCases   Case[]
  diagnosisAttempts DiagnosisAttempt[]
}

/// A player's diagnosis/treatment submission for a Case, and the game's verdict.
model DiagnosisAttempt {
  id                  String     @id @default(uuid(7)) @db.Uuid
  gameDayLogId        String     @db.Uuid
  gameDayLog          GameDayLog @relation(fields: [gameDayLogId], references: [id])
  caseId              String     @db.Uuid
  case                Case       @relation(fields: [caseId], references: [id])
  selectedDiagnosisId String     @db.Uuid
  selectedDiagnosis   Diagnosis  @relation(fields: [selectedDiagnosisId], references: [id])
  selectedTreatmentId String?    @db.Uuid
  selectedTreatment   Treatment? @relation(fields: [selectedTreatmentId], references: [id])
  isDiagnosisCorrect  Boolean
  isTreatmentCorrect  Boolean?
  moneyDelta          Int
  attemptedAt         DateTime   @default(now())

  @@index([gameDayLogId, attemptedAt])
  @@index([caseId])
  @@index([selectedDiagnosisId])
  @@index([selectedTreatmentId])
}
