# Copy to .env and adjust as needed. Vite only exposes variables prefixed with VITE_.

# Backend API base URL.
VITE_API_BASE_URL=http://localhost:4000
# OAuth 2.0 client ID from Google Cloud Console credentials for this project (not secret) —
# must match the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional. How long a day phase lasts, in seconds, before it auto-ends (see docs/api/day.md).
# Defaults to 60 if unset — must match the backend's own DAY_DURATION_SECONDS
# (src/backend/.env.example), or use docker/.env's single DAY_DURATION_SECONDS when running
# via docker compose. Baked into the build at build time (Vite env vars aren't runtime-injectable).
VITE_DAY_DURATION_SECONDS=60
