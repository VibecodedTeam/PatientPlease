# Copy to docker/.env and adjust as needed.
# docker compose automatically loads docker/.env when run with -f docker/docker-compose.yml.

POSTGRES_USER=game
POSTGRES_PASSWORD=game
POSTGRES_DB=skin_disease_game
POSTGRES_PORT=5432

# Google OAuth client ID (not secret) and the session cookie signing secret. The backend
# service falls back to dev-only defaults if these are unset, since /health never exercises
# /auth/google — set a real value here for a local sign-in flow that talks to real Google.
# Used for both the backend's audience check and the frontend build's Sign-In button — one
# value, no separate VITE_ variant to keep in sync.
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
COOKIE_SECRET=dev-only-insecure-secret-change-me
FRONTEND_ORIGIN=http://localhost:4173

# Chat: Google Generative Language API key for the Gemini model backing POST /api/v1/chat.
GEMINI_API_KEY=docker-dev-not-a-real-gemini-key
# Whisper (open-source) speech-to-text server — OpenAI-compatible /audio/transcriptions endpoint.
WHISPER_BASE_URL=http://localhost:8000/v1
WHISPER_MODEL=whisper-1

# How long a day phase lasts, in seconds, before it auto-ends (see docs/api/day.md). Read by
# both the backend's anti-cheat minimum (src/backend/src/constants.ts) and the frontend's day
# timer (src/frontend GameSessionProvider, built in via VITE_DAY_DURATION_SECONDS) — one value,
# no separate VITE_ variant to keep in sync. Defaults to 60 if unset.
DAY_DURATION_SECONDS=60
