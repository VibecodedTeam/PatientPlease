# Copy to docker/.env and adjust as needed.
# docker compose automatically loads docker/.env when run with -f docker/docker-compose.yml.

POSTGRES_USER=game
POSTGRES_PASSWORD=game
POSTGRES_DB=skin_disease_game
POSTGRES_PORT=5432

# Google OAuth client ID (not secret) and the session cookie signing secret. The backend
# service falls back to dev-only defaults if these are unset, since /health never exercises
# /auth/google — set real values here for a local sign-in flow that talks to real Google.
GOOGLE_CLIENT_ID=test-client-id.apps.googleusercontent.com
COOKIE_SECRET=dev-only-insecure-secret-change-me
FRONTEND_ORIGIN=http://localhost:4173
GEMINI_API_KEY=docker-dev-not-a-real-gemini-key
GOOGLE_SPEECH_API_KEY=docker-dev-not-a-real-speech-key
